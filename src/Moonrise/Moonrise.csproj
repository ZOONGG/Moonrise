<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\branding\moonrise-icon.ico</ApplicationIcon>
    <AssemblyName>Moonrise</AssemblyName>
    <RootNamespace>Moonrise</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Authors>ZOONGG</Authors>
    <Company>ZOONGG</Company>
    <Copyright>Copyright © 2026 ZOONGG</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Product>Moonrise</Product>
    <Title>Moonrise</Title>
    <Description>A modern mod manager and launcher for Lunar Client.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\languages\*.moonrise-language.json" LogicalName="Moonrise.LanguagePacks.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\languages\*.template.json" LogicalName="Moonrise.LanguageTemplates.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\languages\README.md" LogicalName="Moonrise.LanguageTemplates.README.md" />
    <PackageReference Include="NSec.Cryptography" Version="25.4.0" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <Resource Include="..\..\assets\branding\moonrise-icon.ico" Link="Assets\moonrise-icon.ico" />
    <Resource Include="..\..\assets\branding\moonrise-icon-128.png" Link="Assets\moonrise-icon-128.png" />
    <Resource Include="..\..\assets\branding\moonrise-tray.ico" Link="Assets\moonrise-tray.ico" />
    <Resource Include="Assets\LunarClient.png" />
    <Resource Include="Assets\weave-mod-icon.png" />
    <Resource Include="Assets\Backgrounds\moonrise-cosmic-hero.png" />
    <EmbeddedResource Include="..\..\runtime\bridge\Moonrise.Native.dll"
                      LogicalName="Moonrise.NativeBridge.dll" />
    <EmbeddedResource Include="..\..\runtime\adapters\moonrise-bwh-exitlag-network-agent.jar"
                      LogicalName="Moonrise.BwhNetworkAgent.jar" />
    <Content Include="..\..\runtime\bridge\Moonrise.Native.dll"
             Link="runtime\bridge\Moonrise.Native.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Content Include="..\..\README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
