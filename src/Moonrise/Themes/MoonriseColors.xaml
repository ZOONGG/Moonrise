<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Moonlight semantic palette. Keep color values here and consume brushes elsewhere. -->
    <Color x:Key="BackgroundPrimaryColor">#070B15</Color>
    <Color x:Key="BackgroundSecondaryColor">#090F1C</Color>
    <Color x:Key="SurfacePrimaryColor">#0E1727</Color>
    <Color x:Key="SurfaceRaisedColor">#121D31</Color>
    <Color x:Key="SurfaceFloatingColor">#17243A</Color>
    <Color x:Key="SurfaceHoverColor">#16233A</Color>
    <Color x:Key="SurfaceSelectedColor">#1B2850</Color>
    <Color x:Key="SurfaceDisabledColor">#101827</Color>
    <Color x:Key="BorderPrimaryColor">#273956</Color>
    <Color x:Key="BorderSubtleColor">#1B2940</Color>
    <Color x:Key="BorderStrongColor">#3A5278</Color>
    <Color x:Key="FocusColor">#8B6FFF</Color>
    <Color x:Key="TextPrimaryColor">#F5F7FC</Color>
    <Color x:Key="TextSecondaryColor">#AAB6CA</Color>
    <Color x:Key="TextMutedColor">#7182A1</Color>
    <Color x:Key="TextDisabledColor">#52617B</Color>
    <Color x:Key="AccentPurpleColor">#8B5CF6</Color>
    <Color x:Key="AccentVioletColor">#A855F7</Color>
    <Color x:Key="AccentBlueColor">#4C7CFF</Color>
    <Color x:Key="AccentCyanColor">#22C9E8</Color>
    <Color x:Key="SuccessColor">#42D6A4</Color>
    <Color x:Key="WarningColor">#F2C45C</Color>
    <Color x:Key="DangerColor">#F05B6B</Color>

    <SolidColorBrush x:Key="BackgroundPrimary" Color="{StaticResource BackgroundPrimaryColor}"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="{StaticResource BackgroundSecondaryColor}"/>
    <SolidColorBrush x:Key="SurfacePrimary" Color="{StaticResource SurfacePrimaryColor}"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="SurfaceFloating" Color="{StaticResource SurfaceFloatingColor}"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="SurfaceSelected" Color="{StaticResource SurfaceSelectedColor}"/>
    <SolidColorBrush x:Key="SurfaceDisabled" Color="{StaticResource SurfaceDisabledColor}"/>
    <SolidColorBrush x:Key="BorderPrimary" Color="{StaticResource BorderPrimaryColor}"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="FocusRing" Color="{StaticResource FocusColor}"/>
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="AccentPurple" Color="{StaticResource AccentPurpleColor}"/>
    <SolidColorBrush x:Key="AccentViolet" Color="{StaticResource AccentVioletColor}"/>
    <SolidColorBrush x:Key="AccentBlue" Color="{StaticResource AccentBlueColor}"/>
    <SolidColorBrush x:Key="AccentCyan" Color="{StaticResource AccentCyanColor}"/>
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>

    <!-- Compatibility aliases used by existing appearance packs and page markup. -->
    <SolidColorBrush x:Key="SurfaceSecondary" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="SurfaceElevated" Color="{StaticResource SurfaceFloatingColor}"/>
    <SolidColorBrush x:Key="BorderActive" Color="{StaticResource FocusColor}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource SurfacePrimaryColor}"/>
    <SolidColorBrush x:Key="Panel2" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentPurpleColor}"/>

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#915EF5" Offset="0"/>
        <GradientStop Color="#5D72F4" Offset="0.57"/>
        <GradientStop Color="#27BFD8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGradientHover" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#9E6BFA" Offset="0"/>
        <GradientStop Color="#6980FF" Offset="0.57"/>
        <GradientStop Color="#35CBE3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGradientPressed" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#7D50D7" Offset="0"/>
        <GradientStop Color="#4B60D1" Offset="0.57"/>
        <GradientStop Color="#1DA5BF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ActiveNavigationGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#30254F" Offset="0"/>
        <GradientStop Color="#192B4D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0.9,1">
        <GradientStop Color="#090F1D" Offset="0"/>
        <GradientStop Color="#080D19" Offset="0.62"/>
        <GradientStop Color="#0B1120" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroOverlay" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#F5070B15" Offset="0"/>
        <GradientStop Color="#DE09101D" Offset="0.48"/>
        <GradientStop Color="#7209101D" Offset="0.75"/>
        <GradientStop Color="#B3070B15" Offset="1"/>
    </LinearGradientBrush>

    <BitmapImage x:Key="CosmicHeroImage"
                 UriSource="/Moonrise;component/Assets/Backgrounds/moonrise-cosmic-hero.png"
                 DecodePixelWidth="1600"
                 CacheOption="OnLoad"
                 CreateOptions="PreservePixelFormat"/>
</ResourceDictionary>
