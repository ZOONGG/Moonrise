<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:Moonrise.Services"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <Style TargetType="ScrollViewer">
        <Setter Property="services:SmoothScroll.IsEnabled" Value="True"/>
        <Setter Property="PanningMode" Value="VerticalFirst"/>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <DropShadowEffect x:Key="FloatingShadow" BlurRadius="18" ShadowDepth="5" Opacity="0.34" Color="#000000" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="PrimaryButtonShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.24" Color="#3854BD" RenderingBias="Performance"/>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimary}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="FocusBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRing}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
    </Style>

    <!-- Buttons: overlays and transforms animate without changing layout dimensions. -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="MinWidth" Value="92"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ButtonRadius}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="HoverOverlay" Background="#FFFFFF" CornerRadius="9" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" SnapsToDevicePixels="True"/>
                            </Grid>
                        </Border>
                        <Border x:Name="FocusOutline" BorderBrush="{DynamicResource FocusRing}" BorderThickness="1"
                                CornerRadius="{StaticResource ButtonRadius}" Margin="-2" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.065" Duration="{StaticResource ControlDuration}" EasingFunction="{StaticResource ControlEase}"/></Storyboard></BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource FastDuration}" EasingFunction="{StaticResource ControlEase}"/></Storyboard></BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Opacity" Value="0.9"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter><Setter TargetName="HoverOverlay" Property="Opacity" Value="0.02"/><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceDisabled}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/><Setter TargetName="Surface" Property="Opacity" Value="0.72"/><Setter TargetName="FocusOutline" Property="Opacity" Value="0"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Height" Value="52"/>
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryGradient}"/>
        <Setter Property="BorderBrush" Value="#7EA3E5FF"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Border x:Name="Depth" Background="{DynamicResource SurfaceSelected}" CornerRadius="12" Margin="1,2,1,0"/>
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource ButtonRadius}" Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource PrimaryButtonShadow}" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="HoverOverlay" Background="#FFFFFF" CornerRadius="9" Opacity="0"/>
                                <Border BorderBrush="#52FFFFFF" BorderThickness="0,1,0,0" CornerRadius="9"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="FocusOutline" BorderBrush="{DynamicResource AccentCyan}" BorderThickness="1" CornerRadius="12" Margin="-2" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard><DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.09" Duration="{StaticResource ControlDuration}" EasingFunction="{StaticResource ControlEase}"/><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-1" Duration="{StaticResource FastDuration}" EasingFunction="{StaticResource ControlEase}"/></Storyboard></BeginStoryboard></EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard><DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource FastDuration}" EasingFunction="{StaticResource ControlEase}"/><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="{StaticResource FastDuration}" EasingFunction="{StaticResource ControlEase}"/></Storyboard></BeginStoryboard></EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PrimaryGradientHover}"/><Setter TargetName="Surface" Property="BorderBrush" Value="#B0C5F4FF"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Opacity" Value="0.95"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PrimaryGradientPressed}"/><Setter TargetName="Surface" Property="Effect" Value="{x:Null}"/><Setter TargetName="Depth" Property="Opacity" Value="0.35"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceDisabled}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/><Setter TargetName="Surface" Property="Effect" Value="{x:Null}"/><Setter TargetName="Depth" Property="Opacity" Value="0"/><Setter TargetName="HoverOverlay" Property="Opacity" Value="0"/><Setter TargetName="FocusOutline" Property="Opacity" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="#2A151F"/>
        <Setter Property="BorderBrush" Value="#6C3045"/>
        <Setter Property="Foreground" Value="#FFB8C4"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="38"/><Setter Property="MinWidth" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Height" Value="{StaticResource CompactControlHeight}"/><Setter Property="MinWidth" Value="72"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/><Setter Property="Focusable" Value="False"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>
    <Style x:Key="SocialButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>

    <!-- Sidebar navigation keeps a stable one-pixel shell and a separate active marker. -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Height" Value="48"/><Setter Property="Margin" Value="12,3"/><Setter Property="Padding" Value="14,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="{StaticResource ControlRadius}" BorderBrush="Transparent" BorderThickness="1"/>
                        <Border x:Name="AccentLine" Width="3" Height="24" HorizontalAlignment="Left" Margin="1,0,0,0" CornerRadius="1.5" Background="{DynamicResource PrimaryGradient}" Opacity="0"/>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Path x:Name="Icon" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.65" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,1"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceHover}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ActiveNavigationGradient}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/><Setter TargetName="AccentLine" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FilterButton" TargetType="RadioButton">
        <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="16,0"/><Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="Surface" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceHover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceSelected}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FocusRing}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentCyan}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfacePrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/><Setter Property="Padding" Value="{StaticResource CardPadding}"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>
    <Style x:Key="LaunchCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Background" Value="{DynamicResource SurfacePrimary}"/></Style>
    <Style x:Key="InteractiveTile" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="16"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceHover}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/></Trigger></Style.Triggers></Style>
    <Style x:Key="SettingsSection" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Width" Value="426"/><Setter Property="MinHeight" Value="160"/><Setter Property="Margin" Value="0,0,16,16"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
    <Style x:Key="SettingsRow" TargetType="Border"><Setter Property="Padding" Value="0,13"/><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>

    <!-- Inputs keep a permanent one-pixel surface; focus is a non-layout overlay. -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/><Setter Property="Padding" Value="13,0"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="CaretBrush" Value="{DynamicResource AccentCyan}"/><Setter Property="Background" Value="{DynamicResource BackgroundSecondary}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentPurple}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
            <Grid><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ScrollViewer x:Name="PART_ContentHost"/></Border><Border x:Name="FocusOutline" BorderBrush="{DynamicResource FocusRing}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Margin="-2" Opacity="0" IsHitTestVisible="False"/></Grid>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceDisabled}"/><Setter TargetName="Surface" Property="Opacity" Value="0.72"/><Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SearchInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="38,0,13,0"/></Style>

    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/><Setter Property="Padding" Value="13,0"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="{DynamicResource BackgroundSecondary}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" SnapsToDevicePixels="True"><Grid><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextElement.Foreground="{TemplateBinding Foreground}" Margin="13,0,40,1" VerticalAlignment="Center"/><Path x:Name="Chevron" Data="M4,8 L8,12 L12,8" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" HorizontalAlignment="Right" Margin="0,0,12,0"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/><Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource TextSecondary}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <Border x:Name="FocusOutline" BorderBrush="{DynamicResource FocusRing}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Margin="-2" Opacity="0" IsHitTestVisible="False"/>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                    <Border x:Name="PopupSurface" Background="{DynamicResource SurfaceFloating}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="{StaticResource PopupRadius}" Padding="5" Margin="0,6,0,12" MinWidth="{Binding PlacementTarget.ActualWidth, ElementName=PART_Popup}" Effect="{StaticResource FloatingShadow}" SnapsToDevicePixels="True" Opacity="0">
                        <Border.RenderTransform><TranslateTransform Y="-4"/></Border.RenderTransform>
                        <ScrollViewer MaxHeight="280" CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusOutline" Property="Opacity" Value="0.9"/></Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter TargetName="FocusOutline" Property="Opacity" Value="0.8"/>
                    <Trigger.EnterActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="PopupSurface" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource PopupDuration}" EasingFunction="{StaticResource StandardEase}"/>
                        <DoubleAnimation Storyboard.TargetName="PopupSurface" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-4" To="0" Duration="{StaticResource PopupDuration}" EasingFunction="{StaticResource StandardEase}"/>
                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="DropDownToggle" Property="Opacity" Value="0.55"/><Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,8"/><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SurfaceHover}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SurfaceSelected}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style></Setter.Value></Setter>
    </Style>

    <Style x:Key="SmoothSwitch" TargetType="CheckBox">
        <Setter Property="Width" Value="42"/><Setter Property="Height" Value="24"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid Width="42" Height="24" SnapsToDevicePixels="True"><Border x:Name="Track" CornerRadius="12" Background="{DynamicResource SurfaceSelected}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"/><Ellipse x:Name="Thumb" Width="18" Height="18" Fill="{DynamicResource TextSecondary}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"><Ellipse.RenderTransform><TranslateTransform X="0"/></Ellipse.RenderTransform></Ellipse><Border x:Name="FocusOutline" BorderBrush="{DynamicResource AccentCyan}" BorderThickness="1" CornerRadius="13" Margin="-2" Opacity="0"/></Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryGradient}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/><Setter TargetName="Thumb" Property="Fill" Value="White"/>
                    <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="{StaticResource ToggleDuration}" EasingFunction="{StaticResource ToggleEase}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="{StaticResource ToggleDuration}" EasingFunction="{StaticResource ToggleEase}"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.92"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Opacity" Value="0.9"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Foreground" Value="#FF899B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9"><Viewbox Width="17" Height="17"><Path Data="{StaticResource IconDelete}" Stroke="#FF899B" StrokeThickness="1.6" Fill="Transparent" StrokeLineJoin="Round"/></Viewbox></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#321B26"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FF899B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="LanguageButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Width" Value="82"/><Setter Property="MinWidth" Value="82"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="10,0"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
    <Style x:Key="LanguageOptionStyle" TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinWidth" Value="124"/></Style>
    <Style x:Key="Badge" TargetType="Border"><Setter Property="CornerRadius" Value="{StaticResource BadgeRadius}"/><Setter Property="Padding" Value="8,4"/><Setter Property="Background" Value="{DynamicResource SurfaceSelected}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>

    <Style x:Key="StatusIndicator" TargetType="ContentControl">
        <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="Foreground" Value="{DynamicResource TextMuted}"/><Setter Property="Focusable" Value="False"/>
