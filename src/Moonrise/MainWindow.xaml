        </ControlTemplate>

        <Style x:Key="ClientCard" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Width="318" Height="108" Background="{DynamicResource ClientCardBackground}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="15" Padding="17">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource ClientIconBackground}" BorderBrush="{DynamicResource ClientIconBorder}" BorderThickness="{DynamicResource PackageIconBorderThickness}">
                                        <Grid>
                                            <Viewbox Width="34" Height="34">
                                                <Canvas Width="168" Height="153">
                                                    <Path Fill="{DynamicResource LunarIconForeground}" Data="M162,55.81v63l-11-.68V58.76a18.53,18.53,0,0,0-9.83-16.16L94.23,15.83a20.54,20.54,0,0,0-19.66,0L27.74,42.6a18.51,18.51,0,0,0-9.83,16.16v59.35l-11.06.67v-63A22.92,22.92,0,0,1,18.32,36L72.94,3.07a22.94,22.94,0,0,1,22.92,0L150.49,36A22.93,22.93,0,0,1,162,55.81Z"/>
                                                    <Path Fill="{DynamicResource LunarIconForeground}" Data="M110.14,104.23A51.82,51.82,0,0,1,67.55,30.89a51.82,51.82,0,1,0,66.29,69.83A51.64,51.64,0,0,1,110.14,104.23Z"/>
                                                    <Path Fill="{DynamicResource LunarIconForeground}" Data="M167.8,125.73 L167.8,122.7 L0,122.7 L0,125.73 L14.99,125.73 L14.99,129.49 L0,129.49 L0,132.51 L26.33,132.51 L26.33,136.27 L2.94,136.27 L2.94,139.3 L39.99,139.3 L39.99,143.06 L21.24,143.06 L21.24,146.08 L63.31,146.08 L63.31,149.84 L57.34,149.84 L57.34,152.86 L111.48,152.86 L111.48,149.84 L104.73,149.84 L104.73,146.08 L146.56,146.08 L146.56,143.06 L128.29,143.06 L128.29,139.3 L164.86,139.3 L164.86,136.27 L142.57,136.27 L142.57,132.51 L167.8,132.51 L167.8,129.49 L154.44,129.49 L154.44,125.73 Z"/>
