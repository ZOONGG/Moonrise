                                    <TextBlock x:Name="SupportWaitingText" Grid.Column="2" Text="Waiting for payment" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                                </Grid>
                                <ProgressBar x:Name="SupportWaitingProgress" Style="{StaticResource SupportWaitingProgress}" Width="220" Height="3"
                                             Margin="0,9,0,0" IsIndeterminate="True" AutomationProperties.Name="Payment status activity"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="SupportSuccessPanel" Visibility="Collapsed" Opacity="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                            <Border x:Name="SupportSuccessVisual" Width="76" Height="76" CornerRadius="38" Background="{DynamicResource AccentSoft}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                <Grid>
                                    <Viewbox Width="34" Height="34"><Path Data="{StaticResource IconHeart}" Fill="{DynamicResource Danger}"/></Viewbox>
                                    <Image x:Name="SupportSuccessStarsIcon" Source="{StaticResource TelegramStarsIcon}" Width="17" Height="17" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="SupportThankYouTitle" Text="Thank you for your support!" FontSize="25" FontWeight="SemiBold" Margin="0,24,0,0" HorizontalAlignment="Center"/>
                            <Border Margin="0,16,0,0" Padding="14,7" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="18">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SupportThankYouAmountText" Text="$1" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                    <Image x:Name="SupportThankYouStarsIcon" Source="{StaticResource TelegramStarsIcon}" Width="20" Height="20" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="SupportThankYouText" Text="Your support helps keep Moonrise free and moving forward."
                                       Foreground="{DynamicResource TextPrimary}" Opacity="0.86" FontSize="14" LineHeight="22" MaxWidth="400"
                                       Margin="0,20,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="SupportDoneButton" Content="Done" Style="{StaticResource PrimaryButton}" Width="160" HorizontalAlignment="Center"
                                    Margin="0,28,0,0" Click="SupportCloseButton_Click" IsDefault="True"/>
                        </StackPanel>

                        <StackPanel x:Name="SupportTerminalPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470">
                            <Border Width="58" Height="58" CornerRadius="29" Background="{DynamicResource AccentSoft}">
                                <TextBlock x:Name="SupportTerminalGlyph" Text="!" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="SupportTerminalTitle" Text="This payment session expired." FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SupportTerminalText" Text="Create a new payment to continue." Foreground="{DynamicResource TextMuted}" Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="SupportCreateNewButton" Content="Create new payment" Style="{StaticResource PrimaryButton}"
                                    Margin="0,22,0,0" HorizontalAlignment="Center" Click="SupportCreateNewButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="SupportCopyToast" Panel.ZIndex="30" Visibility="Collapsed" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                    Background="{DynamicResource SurfaceFloating}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1"
                    CornerRadius="10" Padding="14,8">
                <TextBlock x:Name="SupportCopyToastText" Text="Copied" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <ItemsControl x:Name="ToastHost" Grid.RowSpan="3" Panel.ZIndex="120" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22" IsHitTestVisible="True">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel VerticalAlignment="Bottom"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
                    <Border x:Name="ToastSurface" Background="{DynamicResource SurfaceFloating}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="{DynamicResource PopupBorderThickness}" CornerRadius="{DynamicResource PopupRadius}" Padding="14,11" Width="330" Margin="0,6,0,0" AutomationProperties.Name="{Binding Title}" Loaded="ToastBorder_Loaded">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><Border Width="25" Height="25" CornerRadius="8" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top"><TextBlock x:Name="ToastGlyph" Text="{Binding Glyph}" Foreground="{DynamicResource Accent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,4,0"><TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Content="×" Style="{StaticResource ButtonBase}" Width="30" Height="30" Padding="0" Tag="{Binding}" Click="ToastCloseButton_Click"/></Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid x:Name="DeleteConfirmationOverlay" Grid.RowSpan="3" Panel.ZIndex="100" Background="{DynamicResource OverlaySurface}" Visibility="Collapsed">
            <Border x:Name="DeleteDialogPanel" Width="470" Background="{DynamicResource SurfaceFloating}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="{DynamicResource PopupBorderThickness}" CornerRadius="{DynamicResource PopupRadius}" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource DangerSurface}" HorizontalAlignment="Left">
                            <Viewbox Width="21" Height="21">
                                <Grid Width="24" Height="24">
                                    <Path Data="M5,7 L6.2,20 C6.3,21 7,21.5 8,21.5 L16,21.5 C17,21.5 17.7,21 17.8,20 L19,7 M3,7 L21,7 M8,7 L8.8,3.8 C8.9,3.3 9.4,3 10,3 L14,3 C14.6,3 15.1,3.3 15.2,3.8 L16,7 M9.5,10.5 L10,18 M14.5,10.5 L14,18" Stroke="{DynamicResource DangerForeground}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                </Grid>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="DeleteConfirmationTitle" Text="Remove package?" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="DeleteConfirmationSubtitle" Text="The file will be deleted from local storage." Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceSecondary}" CornerRadius="{DynamicResource ControlRadius}" Padding="14,12">
                        <TextBlock x:Name="DeleteConfirmationFileName" Text="package.jar" Foreground="{DynamicResource TextSecondary}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DeleteConfirmationCancelButton" Content="Cancel" Style="{StaticResource ButtonBase}" MinWidth="104" Margin="0,0,10,0" Click="DeleteConfirmationCancelButton_Click"/>
                        <Button x:Name="DeleteConfirmationConfirmButton" Content="Remove" Style="{StaticResource ButtonBase}" MinWidth="112" Background="{DynamicResource DangerSurface}" BorderBrush="{DynamicResource DangerBorder}" Foreground="{DynamicResource DangerForeground}" Click="DeleteConfirmationConfirmButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
