                    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="UpdatesTitle" Text="Updates" FontWeight="SemiBold"/><TextBlock x:Name="UpdatesHint" Text="Check official releases on GitHub. Releases are currently unsigned." Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><CheckBox x:Name="CheckForUpdatesCheckBox" Style="{StaticResource SmoothSwitch}" Click="CheckForUpdatesCheckBox_Click"/><TextBlock x:Name="UpdateStatusText" Text="" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><CheckBox x:Name="PrereleaseUpdatesCheckBox" Style="{StaticResource SmoothSwitch}" Click="PrereleaseUpdatesCheckBox_Click"/><TextBlock x:Name="PrereleaseUpdatesText" Text="Prerelease channel" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="CheckUpdateButton" Content="Check" Style="{StaticResource ButtonBase}" Click="CheckUpdateButton_Click"/><Button x:Name="InstallUpdateButton" Content="Install and restart" Style="{StaticResource ButtonBase}" Margin="8,0,0,0" Visibility="Collapsed" Click="InstallUpdateButton_Click"/></StackPanel></Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DiagnosticsSettingsTitle" Text="Diagnostics" FontWeight="SemiBold"/><TextBlock x:Name="DiagnosticsSettingsHint" Text="View local launch and installation events." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="OpenDiagnosticsSettingsButton" Content="Open diagnostics" Style="{StaticResource ButtonBase}" Click="OpenDiagnosticsButton_Click"/><Button x:Name="OpenDiagnosticsLogsButton" Content="Open logs" Style="{StaticResource ButtonBase}" Margin="8,0,0,0" Click="OpenLogsButton_Click"/></StackPanel></Grid></Border>
