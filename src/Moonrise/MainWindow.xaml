                                <Grid Width="24" Height="24">
                                    <Path x:Name="TrashGlyph" Data="M5,7 L6.2,20 C6.3,21 7,21.5 8,21.5 L16,21.5 C17,21.5 17.7,21 17.8,20 L19,7 M3,7 L21,7 M8,7 L8.8,3.8 C8.9,3.3 9.4,3 10,3 L14,3 C14.6,3 15.1,3.3 15.2,3.8 L16,7 M9.5,10.5 L10,18 M14.5,10.5 L14,18" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                </Grid>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DangerSurface}"/>
