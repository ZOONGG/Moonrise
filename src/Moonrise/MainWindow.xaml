                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{DynamicResource InputBorderThickness}" CornerRadius="{DynamicResource ControlRadius}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Path x:Name="DropDownArrow" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
